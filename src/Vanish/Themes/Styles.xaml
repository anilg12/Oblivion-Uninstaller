<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Vanish.Controls">

    <!--
        Oblivion "Graphite" design system.
        Neutral surfaces, hairline borders, one indigo accent, semantic colours only where they mean something.
        Theme-dependent tones (surfaces, text, soft tints) live in Palette.Dark / Palette.Light.
    -->

    <!-- ===================== Shared colours (same in both themes) ===================== -->
    <Color x:Key="OB.AccentColor">#4F6BED</Color>
    <Color x:Key="OB.Accent2Color">#4F6BED</Color>
    <SolidColorBrush x:Key="OB.Accent" Color="#4F6BED" />
    <SolidColorBrush x:Key="OB.Accent2" Color="#4F6BED" />
    <SolidColorBrush x:Key="OB.Danger" Color="#E5484D" />
    <SolidColorBrush x:Key="OB.Success" Color="#30A46C" />
    <SolidColorBrush x:Key="OB.Warning" Color="#F2A33A" />
    <SolidColorBrush x:Key="OB.Info" Color="#4F6BED" />
    <SolidColorBrush x:Key="OB.White" Color="#FFFFFF" />

    <!-- Kept for existing references: solid now, no gradients. -->
    <SolidColorBrush x:Key="OB.Brand" Color="#4F6BED" />
    <SolidColorBrush x:Key="OB.BrandH" Color="#4F6BED" />
    <SolidColorBrush x:Key="OB.DangerGradient" Color="#E5484D" />
    <SolidColorBrush x:Key="OB.Signature" Color="#4F6BED" />

    <FontFamily x:Key="OB.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="OB.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="OB.ScriptFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- ===================== Text ===================== -->
    <Style x:Key="OB.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OB.DisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="OB.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Subtext}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="OB.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Text}" />
    </Style>
    <Style x:Key="OB.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="OB.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource OB.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="OB.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Subtext}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="OB.FaintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Faint}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="OB.BigNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OB.DisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Small upper-case group label (sidebar sections, card eyebrows). -->
    <Style x:Key="OB.Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Faint}" />
        <Setter Property="Margin" Value="12,18,0,6" />
    </Style>

    <!-- ===================== Surfaces ===================== -->
    <Style x:Key="OB.CardBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource OB.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OB.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="OB.Row" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource OB.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OB.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="OB.Dialog" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource OB.DialogBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OB.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="28" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.22" Color="#000000" RenderingBias="Performance" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OB.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource OB.Stroke}" />
        <Setter Property="Margin" Value="0,16" />
    </Style>

    <!-- ===================== Buttons ===================== -->
    <!-- Flat buttons: colour change on hover, slight dim on press. No scaling, no glow. -->
    <Style x:Key="OB.BtnBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource OB.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" Background="Transparent">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" />
                        <Border x:Name="hover" Background="{DynamicResource OB.HoverOverlay}" Opacity="0" CornerRadius="8" />
                        <Border x:Name="focus" CornerRadius="10" Margin="-3" BorderThickness="2" BorderBrush="{StaticResource OB.Accent}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focus" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OB.Btn" TargetType="Button" BasedOn="{StaticResource OB.BtnBase}">
        <Setter Property="Background" Value="{DynamicResource OB.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OB.StrokeStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Text}" />
    </Style>
    <Style x:Key="OB.BtnPrimary" TargetType="Button" BasedOn="{StaticResource OB.BtnBase}">
        <Setter Property="Background" Value="{StaticResource OB.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="OB.BtnDanger" TargetType="Button" BasedOn="{StaticResource OB.BtnBase}">
        <Setter Property="Background" Value="{StaticResource OB.Danger}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="OB.BtnGhost" TargetType="Button" BasedOn="{StaticResource OB.BtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Text}" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style x:Key="OB.BtnPrimaryLarge" TargetType="Button" BasedOn="{StaticResource OB.BtnPrimary}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="20,11" />
    </Style>
    <Style x:Key="OB.BtnDangerLarge" TargetType="Button" BasedOn="{StaticResource OB.BtnDanger}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style x:Key="OB.IconBtn" TargetType="Button" BasedOn="{StaticResource OB.Btn}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Card-like clickable tile (tools hub, quick actions). Hover: border and surface brighten. -->
    <Style x:Key="OB.Tile" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" Background="Transparent">
                        <Border x:Name="bg" Background="{DynamicResource OB.Card}" BorderBrush="{DynamicResource OB.Stroke}"
                                BorderThickness="1" CornerRadius="12" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource OB.CardHover}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource OB.StrokeStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact square button (sidebar footer). Active state comes from c:Nav.IsActive. -->
    <Style x:Key="OB.RailBtn" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Subtext}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" CornerRadius="8" Background="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource OB.NavHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource OB.Text}" />
                        </Trigger>
                        <Trigger Property="c:Nav.IsActive" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource OB.NavSelected}" />
                            <Setter Property="Foreground" Value="{DynamicResource OB.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar navigation row -->
    <Style x:Key="OB.NavRow" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Subtext}" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" />
                        <ContentPresenter x:Name="content" Margin="11,8" TextElement.Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource OB.NavHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource OB.Text}" />
                        </Trigger>
                        <Trigger Property="c:Nav.IsActive" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource OB.NavSelected}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource OB.Stroke}" />
                            <Setter Property="Foreground" Value="{DynamicResource OB.NavSelectedText}" />
                            <Setter TargetName="content" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rotating chevron toggle (expanders) -->
    <Style x:Key="OB.ChevronToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Subtext}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bg" CornerRadius="8" Background="Transparent">
                        <ui:SymbolIcon x:Name="chev" Symbol="ChevronRight24" FontSize="14" Foreground="{TemplateBinding Foreground}"
                                       RenderTransformOrigin="0.5,0.5">
                            <ui:SymbolIcon.RenderTransform>
                                <RotateTransform Angle="0" />
                            </ui:SymbolIcon.RenderTransform>
                        </ui:SymbolIcon>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource OB.NavHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="chev" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="90" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="chev" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented choice (RadioButton): the selected segment is a raised surface, like a native segmented control. -->
    <Style x:Key="OB.Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Subtext}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bg" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource OB.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource OB.Card}" />
                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource OB.Stroke}" />
                            <Setter Property="Foreground" Value="{DynamicResource OB.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="OB.SegmentHost" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource OB.CardStrong}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Selectable list rows (application lists) -->
    <Style x:Key="OB.ListItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="bg" CornerRadius="8" Background="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource OB.NavHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource OB.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OB.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource OB.ListItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                  Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain header button for sortable list columns -->
    <Style x:Key="OB.ColumnHeader" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Faint}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="6,4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource OB.NavHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource OB.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon text -->
    <Style x:Key="OB.Icon" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource OB.Subtext}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
