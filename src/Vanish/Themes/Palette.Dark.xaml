<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Oblivion dark palette (navy / violet). Swapped at runtime for the light one. -->
    <LinearGradientBrush x:Key="OB.Window" StartPoint="0,0" EndPoint="0.45,1">
        <GradientStop Color="#2C2F66" Offset="0" />
        <GradientStop Color="#222549" Offset="0.55" />
        <GradientStop Color="#191B36" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="OB.Glow1" Center="0.08,0.0" GradientOrigin="0.08,0.0" RadiusX="0.65" RadiusY="0.55">
        <GradientStop Color="#557C6CF6" Offset="0" />
        <GradientStop Color="#007C6CF6" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="OB.Glow2" Center="1,1" GradientOrigin="1,1" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#40B45BFF" Offset="0" />
        <GradientStop Color="#00B45BFF" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="OB.Rail" Color="#F01C1F3D" />
    <SolidColorBrush x:Key="OB.Panel" Color="#DB2B3164" />
    <SolidColorBrush x:Key="OB.Content" Color="#D122244B" />
    <SolidColorBrush x:Key="OB.Right" Color="#E62C2F48" />
    <SolidColorBrush x:Key="OB.NavSelected" Color="#13152B" />
    <SolidColorBrush x:Key="OB.NavSelectedText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OB.NavHover" Color="#22000000" />
    <SolidColorBrush x:Key="OB.Card" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="OB.CardHover" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="OB.CardStrong" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="OB.Stroke" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="OB.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OB.Subtext" Color="#9EFFFFFF" />
    <SolidColorBrush x:Key="OB.Faint" Color="#61FFFFFF" />
    <SolidColorBrush x:Key="OB.Input" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="OB.DialogBg" Color="#262A57" />
    <SolidColorBrush x:Key="OB.Backdrop" Color="#99070818" />
    <SolidColorBrush x:Key="OB.Track" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="OB.RailButton" Color="#2B2F58" />
    <SolidColorBrush x:Key="OB.RailButtonText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OB.HoverOverlay" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OB.Shadow" Color="#40000000" />
</ResourceDictionary>
