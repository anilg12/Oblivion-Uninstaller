<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Oblivion "Graphite" — light. Warm off-white canvas, white surfaces, one indigo accent. -->
    <SolidColorBrush x:Key="OB.Window" Color="#F7F7F5" />
    <SolidColorBrush x:Key="OB.Glow1" Color="Transparent" />
    <SolidColorBrush x:Key="OB.Glow2" Color="Transparent" />

    <SolidColorBrush x:Key="OB.Sidebar" Color="#F0F0ED" />
    <SolidColorBrush x:Key="OB.Rail" Color="#F0F0ED" />
    <SolidColorBrush x:Key="OB.Panel" Color="#F0F0ED" />
    <SolidColorBrush x:Key="OB.Content" Color="#F7F7F5" />
    <SolidColorBrush x:Key="OB.Right" Color="#F0F0ED" />

    <SolidColorBrush x:Key="OB.NavSelected" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OB.NavSelectedText" Color="#18181B" />
    <SolidColorBrush x:Key="OB.NavHover" Color="#E7E7E3" />

    <SolidColorBrush x:Key="OB.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OB.CardHover" Color="#FBFBF9" />
    <SolidColorBrush x:Key="OB.CardStrong" Color="#EFEFEC" />
    <SolidColorBrush x:Key="OB.Stroke" Color="#E4E3DF" />
    <SolidColorBrush x:Key="OB.StrokeStrong" Color="#D2D1CC" />

    <SolidColorBrush x:Key="OB.Text" Color="#18181B" />
    <SolidColorBrush x:Key="OB.Subtext" Color="#5E5E66" />
    <SolidColorBrush x:Key="OB.Faint" Color="#93939B" />

    <SolidColorBrush x:Key="OB.Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OB.DialogBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OB.Backdrop" Color="#4D18181B" />
    <SolidColorBrush x:Key="OB.Track" Color="#E8E7E3" />
    <SolidColorBrush x:Key="OB.RailButton" Color="#E7E7E3" />
    <SolidColorBrush x:Key="OB.RailButtonText" Color="#18181B" />
    <SolidColorBrush x:Key="OB.HoverOverlay" Color="#18181B" />
    <SolidColorBrush x:Key="OB.Shadow" Color="#1A18181B" />

    <!-- Accent tones that depend on the background. -->
    <SolidColorBrush x:Key="OB.AccentText" Color="#3A52C9" />
    <SolidColorBrush x:Key="OB.AccentSoft" Color="#1A4F6BED" />
    <SolidColorBrush x:Key="OB.DangerSoft" Color="#1AE5484D" />
    <SolidColorBrush x:Key="OB.SuccessSoft" Color="#1C30A46C" />
    <SolidColorBrush x:Key="OB.WarningSoft" Color="#22F2A33A" />
    <SolidColorBrush x:Key="OB.DangerText" Color="#C9353B" />
    <SolidColorBrush x:Key="OB.SuccessText" Color="#23824F" />
    <SolidColorBrush x:Key="OB.WarningText" Color="#A8650A" />
    <Color x:Key="OB.ShadowColor">#18181B</Color>
</ResourceDictionary>
