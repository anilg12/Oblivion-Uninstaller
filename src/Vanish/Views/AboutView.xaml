<UserControl
    x:Class="Vanish.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    Width="540"
    Focusable="True">

    <Border CornerRadius="16" Background="{DynamicResource OB.DialogBg}" BorderBrush="{DynamicResource OB.Stroke}" BorderThickness="1"
            ClipToBounds="True">
        <StackPanel>
            <!-- header -->
            <Grid Margin="28,24,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Oblivion;component/Assets/OblivionLogo.png" Width="44" Height="44"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Oblivion" Foreground="{DynamicResource OB.Text}" FontSize="17" FontWeight="SemiBold"
                                   FontFamily="{StaticResource OB.DisplayFont}" />
                        <TextBlock x:Name="VersionLine" Foreground="{DynamicResource OB.Faint}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" MinHeight="32" Padding="0"
                        Style="{StaticResource OB.BtnGhost}" Click="Close_Click" ToolTip="{h:L Act_Close}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource OB.Subtext}" />
                </Button>
            </Grid>

            <Border Style="{StaticResource OB.Divider}" Margin="28,20,28,22" />

            <!-- developer -->
            <Grid Margin="28,0,28,0" HorizontalAlignment="Left">
                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource OB.CardStrong}"
                        BorderBrush="{DynamicResource OB.Stroke}" BorderThickness="1">
                    <TextBlock Text="AG" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource OB.Text}"
                               FontFamily="{StaticResource OB.DisplayFont}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- signature + role -->
            <StackPanel Margin="28,14,28,0">
                <TextBlock x:Name="Signature" Text="Anıl Gül" FontFamily="{StaticResource OB.DisplayFont}" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource OB.Text}">
                    <TextBlock.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop x:Name="InkStop1" Color="Black" Offset="1" />
                            <GradientStop x:Name="InkStop2" Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </TextBlock.OpacityMask>
                </TextBlock>
                <TextBlock Text="{h:L About_Role}" Style="{StaticResource OB.Subtitle}" FontSize="13.5" Margin="0,2,0,0" />

                <WrapPanel Margin="0,16,0,0">
                    <Button Style="{StaticResource OB.BtnPrimary}" Click="GitHub_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Code24" FontSize="15" Foreground="White" Margin="0,0,7,0" />
                            <TextBlock Text="github.com/anilg12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OB.Btn}" Click="Repo_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Star24" FontSize="15" Margin="0,0,7,0" />
                            <TextBlock Text="{h:L About_Repo}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OB.Btn}" Click="Releases_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="15" Margin="0,0,7,0" />
                            <TextBlock Text="{h:L About_Releases}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <Border Style="{StaticResource OB.Divider}" Margin="28,10,28,18" />

            <!-- what's new -->
            <StackPanel Margin="28,0,28,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Foreground="{DynamicResource OB.Subtext}" Margin="0,0,8,0" />
                    <TextBlock Text="{h:L About_WhatsNew}" Style="{StaticResource OB.Section}" />
                </StackPanel>
                <ItemsControl x:Name="WhatsNew">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource OB.CardStrong}" Margin="0,1,10,0"
                                        VerticalAlignment="Top">
                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="11" Foreground="{DynamicResource OB.Subtext}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource OB.Body}" FontSize="12.5"
                                           TextWrapping="Wrap" TextTrimming="None" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Margin="28,12,28,24">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource OB.FaintText}" Text="{h:L About_Copyright}" />
                <Button HorizontalAlignment="Right" Style="{StaticResource OB.Btn}" MinWidth="96" Click="Close_Click" Content="{h:L Act_Close}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
