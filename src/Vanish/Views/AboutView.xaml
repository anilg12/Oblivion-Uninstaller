<UserControl
    x:Class="Vanish.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    Width="540"
    Focusable="True">

    <Border CornerRadius="22" Background="{DynamicResource OB.DialogBg}" BorderBrush="{DynamicResource OB.Stroke}" BorderThickness="1"
            ClipToBounds="True">
        <StackPanel>
            <!-- ===== Header band ===== -->
            <Grid Height="148" ClipToBounds="True">
                <Border Background="{StaticResource OB.Brand}" CornerRadius="21,21,0,0" />
                <Ellipse Width="260" Height="260" Fill="#1FFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-120,-70,0" />
                <Ellipse Width="150" Height="150" Fill="#14FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-40,0,0,-80" />
                <Ellipse Width="70" Height="70" Fill="#12FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,150,-30" />

                <StackPanel Orientation="Horizontal" Margin="26,22,0,0" VerticalAlignment="Top">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#33FFFFFF">
                        <Image Source="pack://application:,,,/Oblivion;component/Assets/OblivionLogo.png" Width="26" Height="26"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Oblivion" Foreground="White" FontSize="15" FontWeight="Bold" />
                        <TextBlock x:Name="VersionLine" Foreground="#CCFFFFFF" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Width="32" Height="32" Padding="0"
                        Style="{StaticResource OB.BtnGhost}" Foreground="White" Click="Close_Click" ToolTip="{h:L Act_Close}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" Foreground="White" />
                </Button>
            </Grid>

            <!-- ===== Avatar, overlapping the band ===== -->
            <Grid Margin="26,-52,26,0" HorizontalAlignment="Left">
                <Grid Width="104" Height="104">
                    <!-- slowly turning gradient ring (stops as soon as the dialog closes) -->
                    <Ellipse x:Name="AvatarRing" StrokeThickness="4" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8FC0FF" Offset="0" />
                                <GradientStop Color="#B45BFF" Offset="0.5" />
                                <GradientStop Color="#FF7AC6" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="AvatarRotate" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Margin="7" Fill="{DynamicResource OB.DialogBg}" />
                    <Ellipse Margin="10" Fill="{StaticResource OB.Brand}" />
                    <TextBlock Text="AG" FontSize="34" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource OB.DisplayFont}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- ===== Signature + role ===== -->
            <StackPanel Margin="28,8,28,0">
                <TextBlock x:Name="Signature" Text="ANIL GÜL" FontFamily="{StaticResource OB.ScriptFont}" FontSize="40" FontStyle="Italic"
                           Foreground="{StaticResource OB.Signature}">
                    <TextBlock.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop x:Name="InkStop1" Color="Black" Offset="1" />
                            <GradientStop x:Name="InkStop2" Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </TextBlock.OpacityMask>
                </TextBlock>
                <TextBlock Text="{h:L About_Role}" Style="{StaticResource OB.Subtitle}" FontSize="13.5" Margin="2,2,0,0" />

                <WrapPanel Margin="0,14,0,0">
                    <Button Style="{StaticResource OB.BtnPrimary}" Click="GitHub_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Code24" FontSize="15" Foreground="White" Margin="0,0,7,0" />
                            <TextBlock Text="github.com/anilg12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OB.Btn}" Click="Repo_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Star24" FontSize="15" Margin="0,0,7,0" />
                            <TextBlock Text="{h:L About_Repo}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OB.Btn}" Click="Releases_Click" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="15" Margin="0,0,7,0" />
                            <TextBlock Text="{h:L About_Releases}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <Border Style="{StaticResource OB.Divider}" Margin="28,8,28,14" />

            <!-- ===== What's new ===== -->
            <StackPanel Margin="28,0,28,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="16" Foreground="{StaticResource OB.Accent}" Margin="0,0,8,0" />
                    <TextBlock Text="{h:L About_WhatsNew}" Style="{StaticResource OB.Section}" />
                </StackPanel>
                <ItemsControl x:Name="WhatsNew">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource OB.SuccessSoft}" Margin="0,0,10,0"
                                        VerticalAlignment="Top">
                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="11" Foreground="{StaticResource OB.Success}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource OB.Body}" FontSize="12.5"
                                           TextWrapping="Wrap" TextTrimming="None" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Margin="28,10,28,22">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource OB.FaintText}" Text="{h:L About_Copyright}" />
                <Button HorizontalAlignment="Right" Style="{StaticResource OB.Btn}" MinWidth="96" Click="Close_Click" Content="{h:L Act_Close}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
