<ui:FluentWindow
    x:Class="Vanish.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    Title="Oblivion"
    Width="1240"
    Height="800"
    MinWidth="980"
    MinHeight="620"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Title="Oblivion"
            Padding="14,8">
            <ui:TitleBar.Icon>
                <ui:FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ===================== SIDEBAR ===================== -->
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="10,0,6,10"
            Padding="10"
            Background="#26000000"
            CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.25" Color="Black" />
            </Border.Effect>

            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="8,6,8,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF5B8CFF" Offset="0" />
                                    <GradientStop Color="#FF9B5BFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ui:FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons"
                                         Foreground="White" FontSize="18"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OBLIVION" FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock FontSize="10" Opacity="0.7"
                                       Text="{Binding [Brand_By], Source={x:Static h:Loc.I}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom: theme + language + signature -->
                <StackPanel DockPanel.Dock="Bottom" Margin="6,12,6,2">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                   Appearance="Secondary" Command="{Binding ToggleThemeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding [Theme], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Stretch"
                                   Appearance="Secondary" Command="{Binding ToggleLanguageCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Language, Source={x:Static h:Loc.I}, Converter={StaticResource LangCodeUpper}}" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                    <TextBlock Text="ANIL G&#220;L" TextAlignment="Center" Margin="0,2,0,0"
                               FontFamily="Ink Free, Segoe Script, Gabriola" FontSize="26" FontStyle="Italic">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF7FB0FF" Offset="0" />
                                <GradientStop Color="#FFC79BFF" Offset="1" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock FontSize="10" Opacity="0.45" TextAlignment="Center" Margin="0,1,0,0"
                               Text="{Binding [Brand_By], Source={x:Static h:Loc.I}}" TextWrapping="Wrap" />
                    <TextBlock FontSize="10" Opacity="0.35" TextAlignment="Center" Margin="0,2,0,0"
                               Text="v1.0.0 · Windows 11" />
                </StackPanel>

                <!-- Middle: action card + nav -->
                <StackPanel>
                    <!-- Action card -->
                    <Border Padding="8" CornerRadius="10" Margin="0,0,0,10"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <StackPanel>
                            <ui:Button HorizontalAlignment="Stretch" Appearance="Danger" Height="42"
                                       Command="{Binding Uninstaller.UninstallCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                    <TextBlock FontSize="15" FontWeight="SemiBold"
                                               Text="{Binding [Act_Uninstall], Source={x:Static h:Loc.I}}" />
                                </StackPanel>
                            </ui:Button>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                           Appearance="Secondary"
                                           Content="{Binding [Act_ForceUninstall], Source={x:Static h:Loc.I}}"
                                           Command="{Binding Uninstaller.ForceUninstallCommand}" />
                                <ui:Button Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Stretch"
                                           x:Name="OtherCommandsButton"
                                           Appearance="Secondary"
                                           Click="OtherCommands_Click"
                                           Content="{Binding [Act_OtherCommands], Source={x:Static h:Loc.I}}">
                                    <ui:Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding [Cmd_OpenInstallFolder], Source={x:Static h:Loc.I}}"
                                                      Command="{Binding Uninstaller.OpenInstallFolderCommand}" />
                                            <MenuItem Header="{Binding [Cmd_OpenRegistry], Source={x:Static h:Loc.I}}"
                                                      Command="{Binding Uninstaller.OpenRegistryCommand}" />
                                            <MenuItem Header="{Binding [Cmd_SearchWeb], Source={x:Static h:Loc.I}}"
                                                      Command="{Binding Uninstaller.SearchWebCommand}" />
                                            <MenuItem Header="{Binding [Cmd_OpenWebsite], Source={x:Static h:Loc.I}}"
                                                      Command="{Binding Uninstaller.OpenWebsiteCommand}" />
                                            <MenuItem Header="{Binding [Cmd_CopyDetails], Source={x:Static h:Loc.I}}"
                                                      Command="{Binding Uninstaller.CopyDetailsCommand}" />
                                            <Separator />
                                            <MenuItem Header="{Binding [Cmd_RemoveEntry], Source={x:Static h:Loc.I}}"
                                                      Command="{Binding Uninstaller.RemoveEntryCommand}" />
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Navigation -->
                    <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,9" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                                    Background="Transparent" CornerRadius="9">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>

                        <ListBoxItem Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_Dashboard], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Uninstaller">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_AllApps], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Monitored">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_Monitored], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="WindowsApps">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE8FC;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_WindowsApps], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="BrowserExt">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_BrowserExt], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Logs">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE81C;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_Logs], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Hunter">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xEADF;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_Hunter], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Tools">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xEC7A;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_Tools], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_Settings], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== PAGE HOST ===================== -->
        <Border Grid.Row="1" Grid.Column="1" Margin="6,0,10,10"
                Background="#18000000" CornerRadius="14">
            <ContentControl x:Name="PageHost" />
        </Border>
    </Grid>
</ui:FluentWindow>
