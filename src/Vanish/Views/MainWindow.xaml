<ui:FluentWindow
    x:Class="Vanish.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    Title="Oblivion"
    Width="1280"
    Height="820"
    MinWidth="1080"
    MinHeight="640"
    WindowBackdropType="None"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#2B2F58" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource OblivionAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{StaticResource OblivionWindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68" />
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="258" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="4" Title="Oblivion" Padding="14,8">
            <ui:TitleBar.Icon>
                <ui:FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ============ ICON RAIL ============ -->
        <Border Grid.Row="1" Grid.Column="0" Margin="10,0,0,10" CornerRadius="20,0,0,20"
                Background="{StaticResource OblivionRailBrush}">
            <DockPanel Margin="0,10">
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Width="44" Height="44" CornerRadius="14" Margin="0,0,0,12"
                        Background="{StaticResource OblivionLogoBrush}">
                    <ui:FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" Foreground="White"
                                 FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Bottom quick toggles -->
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                    <Button Style="{StaticResource RailButton}" Click="ToggleTheme_Click" ToolTip="Theme">
                        <ui:FontIcon Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                    <Button Style="{StaticResource RailButton}" Click="ToggleLanguage_Click" ToolTip="Language">
                        <TextBlock Text="{Binding Language, Source={x:Static h:Loc.I}, Converter={StaticResource LangCodeUpper}}"
                                   FontSize="12" FontWeight="Bold" />
                    </Button>
                    <Button Style="{StaticResource RailButton}" Tag="Settings" Click="Rail_Click" ToolTip="Settings">
                        <ui:FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                </StackPanel>

                <!-- Quick nav -->
                <StackPanel HorizontalAlignment="Center">
                    <Button Style="{StaticResource RailButton}" Tag="Dashboard" Click="Rail_Click" ToolTip="Dashboard">
                        <ui:FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                    <Button Style="{StaticResource RailButton}" Tag="Uninstaller" Click="Rail_Click" ToolTip="Applications">
                        <ui:FontIcon Glyph="&#xECAA;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                    <Button Style="{StaticResource RailButton}" Tag="WindowsApps" Click="Rail_Click" ToolTip="Windows apps">
                        <ui:FontIcon Glyph="&#xE8FC;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                    <Button Style="{StaticResource RailButton}" Tag="Tools" Click="Rail_Click" ToolTip="Tools">
                        <ui:FontIcon Glyph="&#xEC7A;" FontFamily="Segoe Fluent Icons" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ LABELLED NAV ============ -->
        <Border Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Padding="12"
                Background="{StaticResource OblivionPanelBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="6,4,6,14">
                    <TextBlock Text="OBLIVION" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock FontSize="10" Opacity="0.7" Foreground="White"
                               Text="{Binding [Brand_By], Source={x:Static h:Loc.I}}" />
                </StackPanel>

                <StackPanel>
                    <!-- Action card -->
                    <Border Padding="8" CornerRadius="14" Margin="0,0,0,12" Background="#1E2147">
                        <StackPanel>
                            <ui:Button HorizontalAlignment="Stretch" Appearance="Danger" Height="42"
                                       Command="{Binding Uninstaller.UninstallCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0" />
                                    <TextBlock FontSize="15" FontWeight="SemiBold"
                                               Text="{Binding [Act_Uninstall], Source={x:Static h:Loc.I}}" />
                                </StackPanel>
                            </ui:Button>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                           Appearance="Secondary"
                                           Content="{Binding [Act_ForceUninstall], Source={x:Static h:Loc.I}}"
                                           Command="{Binding Uninstaller.ForceUninstallCommand}" />
                                <ui:Button Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Stretch"
                                           x:Name="OtherCommandsButton" Appearance="Secondary"
                                           Click="OtherCommands_Click"
                                           Content="{Binding [Act_OtherCommands], Source={x:Static h:Loc.I}}">
                                    <ui:Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding [Cmd_OpenInstallFolder], Source={x:Static h:Loc.I}}"
                                                      Command="{Binding Uninstaller.OpenInstallFolderCommand}" />
                                            <MenuItem Header="{Binding [Cmd_OpenRegistry], Source={x:Static h:Loc.I}}"
                                                      Command="{Binding Uninstaller.OpenRegistryCommand}" />
                                            <MenuItem Header="{Binding [Cmd_SearchWeb], Source={x:Static h:Loc.I}}"
                                                      Command="{Binding Uninstaller.SearchWebCommand}" />
                                            <MenuItem Header="{Binding [Cmd_OpenWebsite], Source={x:Static h:Loc.I}}"
                                                      Command="{Binding Uninstaller.OpenWebsiteCommand}" />
                                            <MenuItem Header="{Binding [Cmd_CopyDetails], Source={x:Static h:Loc.I}}"
                                                      Command="{Binding Uninstaller.CopyDetailsCommand}" />
                                            <Separator />
                                            <MenuItem Header="{Binding [Cmd_RemoveEntry], Source={x:Static h:Loc.I}}"
                                                      Command="{Binding Uninstaller.RemoveEntryCommand}" />
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                             Foreground="White" SelectionChanged="NavList_SelectionChanged">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,9" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                                    Background="Transparent" CornerRadius="10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#33121633" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{StaticResource OblivionNavSelectedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>

                        <ListBoxItem Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_Dashboard], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Uninstaller">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_AllApps], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Monitored">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_Monitored], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="WindowsApps">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE8FC;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_WindowsApps], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="BrowserExt">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_BrowserExt], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Logs">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE81C;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_Logs], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Hunter">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xEADF;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_Hunter], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Tools">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xEC7A;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_Tools], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding [Nav_Settings], Source={x:Static h:Loc.I}}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ PAGE HOST ============ -->
        <Border Grid.Row="1" Grid.Column="2" Margin="10,0,10,10" CornerRadius="20"
                Background="#22244B">
            <ContentControl x:Name="PageHost" />
        </Border>

        <!-- ============ RIGHT INFO PANEL ============ -->
        <Border Grid.Row="1" Grid.Column="3" Margin="0,0,10,10" CornerRadius="0,20,20,0"
                Background="{StaticResource OblivionRightBrush}">
            <StackPanel Margin="18,20">
                <!-- Profile / signature card -->
                <Grid Width="92" Height="92" HorizontalAlignment="Center">
                    <Ellipse>
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6E5BFF" Offset="0" />
                                <GradientStop Color="#B45BFF" Offset="1" />
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="AG" FontSize="34" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="ANIL G&#220;L" TextAlignment="Center" Margin="0,12,0,0"
                           FontFamily="Ink Free, Segoe Script, Gabriola" FontSize="30" FontStyle="Italic">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#8FC0FF" Offset="0" />
                            <GradientStop Color="#D7ABFF" Offset="1" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <TextBlock Text="@anilgul" TextAlignment="Center" Foreground="White" Opacity="0.6" FontSize="12" />

                <Separator Margin="0,18,0,14" Background="#22FFFFFF" />

                <!-- System -->
                <TextBlock Text="{Binding [Dash_System], Source={x:Static h:Loc.I}}" Foreground="White"
                           FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Windows" Foreground="White" Opacity="0.6" FontSize="12" />
                    <TextBlock Text="{Binding WindowsVersion}" Foreground="White" HorizontalAlignment="Right" FontSize="12" />
                </Grid>
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="{Binding [Dash_FreeSpace], Source={x:Static h:Loc.I}}" Foreground="White" Opacity="0.6"
                               FontSize="12" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock Text="{Binding FreeSpace}" Foreground="White" FontSize="13" FontWeight="SemiBold" />

                <Separator Margin="0,16,0,14" Background="#22FFFFFF" />

                <!-- Recent activity -->
                <TextBlock Text="{Binding [Dash_RecentActivity], Source={x:Static h:Loc.I}}" Foreground="White"
                           FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding RecentActivity}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Action}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Foreground="White" Opacity="0.55" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="White" Opacity="0.45"
                                           FontSize="10" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
