<ui:FluentWindow
    x:Class="Vanish.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    xmlns:c="clr-namespace:Vanish.Controls"
    Title="Oblivion"
    Width="1360"
    Height="860"
    MinWidth="1040"
    MinHeight="660"
    WindowBackdropType="None"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen"
    FontFamily="{StaticResource OB.Font}"
    Icon="pack://application:,,,/Oblivion;component/Assets/Oblivion.ico"
    UseLayoutRounding="True">

    <Grid x:Name="RootGrid" Background="{DynamicResource OB.Window}">
        <Grid x:Name="ShellGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightColumn" Width="284" />
            </Grid.ColumnDefinitions>

            <!-- sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource OB.Sidebar}" BorderBrush="{DynamicResource OB.Stroke}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,16,14,14">
                    <!-- logo (my name is in About) -->
                    <Grid DockPanel.Dock="Top" Margin="6,2,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/Oblivion;component/Assets/OblivionLogo.png" Width="32" Height="32"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Oblivion" FontFamily="{StaticResource OB.DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource OB.Text}" />
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource OB.FaintText}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- uninstall actions for the selected program -->
                    <Border DockPanel.Dock="Top" CornerRadius="12" Padding="10" Margin="0,0,0,6" Background="{DynamicResource OB.Card}"
                            BorderBrush="{DynamicResource OB.Stroke}" BorderThickness="1">
                        <StackPanel>
                            <Button Style="{StaticResource OB.BtnDanger}" HorizontalAlignment="Stretch" Height="38"
                                    Command="{Binding Uninstaller.UninstallCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" Margin="0,0,8,0" Foreground="White" />
                                    <TextBlock Text="{h:L Act_Uninstall}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Margin="0,0,4,0" Style="{StaticResource OB.Btn}" HorizontalAlignment="Stretch"
                                        FontSize="12" FontWeight="Normal" Padding="6,7" Command="{Binding Uninstaller.ForceUninstallCommand}">
                                    <TextBlock Text="{h:L Act_ForceUninstall}" TextTrimming="CharacterEllipsis" />
                                </Button>
                                <Button x:Name="OtherCommandsButton" Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource OB.Btn}"
                                        HorizontalAlignment="Stretch" FontSize="12" FontWeight="Normal" Padding="6,7" Click="OtherCommands_Click"
                                        IsEnabled="{Binding Uninstaller.HasSelection}">
                                    <TextBlock Text="{h:L Act_OtherCommands}" TextTrimming="CharacterEllipsis" />
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{h:L Cmd_OpenInstallFolder}" Command="{Binding Uninstaller.OpenInstallFolderCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{h:L Cmd_OpenRegistry}" Command="{Binding Uninstaller.OpenRegistryCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Key24" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{h:L Cmd_SearchWeb}" Command="{Binding Uninstaller.SearchWebCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Search24" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{h:L Cmd_OpenWebsite}" Command="{Binding Uninstaller.OpenWebsiteCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Globe24" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{h:L Cmd_CopyDetails}" Command="{Binding Uninstaller.CopyDetailsCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="{h:L Cmd_RemoveEntry}" Command="{Binding Uninstaller.RemoveEntryCommand}">
                                                <MenuItem.Icon><ui:SymbolIcon Symbol="DocumentDismiss24" /></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>
                            <TextBlock Margin="2,9,2,0" Style="{StaticResource OB.FaintText}" TextWrapping="Wrap" TextTrimming="None"
                                       Text="{Binding Uninstaller.SelectionHint}" />
                        </StackPanel>
                    </Border>

                    <!-- footer: settings, theme, language, about -->
                    <StackPanel x:Name="RailBottomPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Style="{StaticResource OB.NavRow}" Tag="Settings" Click="Nav_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,11,0" />
                                        <TextBlock Text="{h:L Nav_Settings}" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        <Border Height="1" Background="{DynamicResource OB.Stroke}" Margin="4,8,4,10" />
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                            <Button x:Name="ThemeButton" Style="{StaticResource OB.RailBtn}" Command="{Binding ToggleThemeCommand}"
                                    ToolTip="{h:L Rail_Theme}">
                                <ui:SymbolIcon x:Name="ThemeIcon" Symbol="WeatherMoon24" FontSize="17" />
                            </Button>
                            <Button Style="{StaticResource OB.RailBtn}" Command="{Binding ToggleLanguageCommand}" ToolTip="{h:L Rail_Language}">
                                <TextBlock Text="{Binding Language, Source={x:Static h:Loc.I}, Converter={StaticResource LangCodeUpper}}"
                                           FontSize="11.5" FontWeight="SemiBold" />
                            </Button>
                            <Button x:Name="AboutButton" Style="{StaticResource OB.RailBtn}" Command="{Binding ShowAboutCommand}" ToolTip="{h:L Rail_About}">
                                <ui:SymbolIcon Symbol="Info24" FontSize="17" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="NavPanel">
                            <TextBlock Text="{h:L Nav_GroupMain}" Style="{StaticResource OB.Eyebrow}" Margin="12,14,0,6" />
                            <Button Style="{StaticResource OB.NavRow}" Tag="Dashboard" Click="Nav_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,11,0" />
                                        <TextBlock Text="{h:L Nav_Dashboard}" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource OB.NavRow}" Tag="Uninstaller" Click="Nav_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="AppsList24" FontSize="16" Margin="0,0,11,0" />
                                        <TextBlock Text="{h:L Nav_AllApps}" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" CornerRadius="6" Padding="6,1"
                                            Visibility="{Binding Uninstaller.TotalCount, Converter={StaticResource PositiveToVisibility}}">
                                        <TextBlock Text="{Binding Uninstaller.TotalCount}" FontSize="11.5" Foreground="{DynamicResource OB.Faint}" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource OB.NavRow}" Tag="WindowsApps" Click="Nav_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="StoreMicrosoft24" FontSize="16" Margin="0,0,11,0" />
                                        <TextBlock Text="{h:L Nav_WindowsApps}" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource OB.NavRow}" Tag="SystemMonitor" Click="Nav_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Pulse24" FontSize="16" Margin="0,0,11,0" />
                                        <TextBlock Text="{h:L Nav_SystemMonitor}" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" CornerRadius="6" Padding="6,1" Background="{DynamicResource OB.AccentSoft}">
                                        <TextBlock Text="{h:L Badge_New}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OB.AccentText}" />
                                    </Border>
                                </Grid>
                            </Button>
                            <TextBlock Text="{h:L Nav_GroupMore}" Style="{StaticResource OB.Eyebrow}" />
                            <Button Style="{StaticResource OB.NavRow}" Tag="Tools" Click="Nav_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Toolbox24" FontSize="16" Margin="0,0,11,0" />
                                        <TextBlock Text="{h:L Nav_Tools}" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource OB.NavRow}" Tag="BrowserExt" Click="Nav_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="16" Margin="0,0,11,0" />
                                        <TextBlock Text="{h:L Nav_BrowserExt}" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource OB.NavRow}" Tag="Monitored" Click="Nav_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="EyeTracking24" FontSize="16" Margin="0,0,11,0" />
                                        <TextBlock Text="{h:L Nav_Monitored}" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource OB.NavRow}" Tag="Hunter" Click="Nav_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Target24" FontSize="16" Margin="0,0,11,0" />
                                        <TextBlock Text="{h:L Nav_Hunter}" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource OB.NavRow}" Tag="Logs" Click="Nav_Click">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="History24" FontSize="16" Margin="0,0,11,0" />
                                        <TextBlock Text="{h:L Nav_Logs}" VerticalAlignment="Center" FontSize="13" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- caption bar (window buttons, drag area) -->
            <ui:TitleBar Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Top" Height="40" Title="" Padding="0" Panel.ZIndex="5" />

            <!-- page host -->
            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="0,40,0,0" Focusable="False" ClipToBounds="True" />

            <!-- live system panel -->
            <Border x:Name="RightPanel" Grid.Column="2" Margin="0,40,0,0" Background="Transparent"
                    BorderBrush="{DynamicResource OB.Stroke}" BorderThickness="1,0,0,0" DataContext="{Binding Live}">
                <DockPanel Margin="22,14,22,18">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{h:L Live_Title}" Style="{StaticResource OB.Section}" VerticalAlignment="Center" />
                            <c:PulseDot Margin="8,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource OB.BtnGhost}" Padding="6,3" FontSize="12" FontWeight="Normal"
                                Tag="SystemMonitor" Click="Nav_Click" ToolTip="{h:L Nav_SystemMonitor}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{h:L Live_Details}" Foreground="{DynamicResource OB.AccentText}" />
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="11" Margin="3,1,0,0" Foreground="{DynamicResource OB.AccentText}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- recent activity -->
                    <StackPanel DockPanel.Dock="Bottom" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Border Height="1" Background="{DynamicResource OB.Stroke}" Margin="0,6,0,16" />
                        <TextBlock Text="{h:L Dash_RecentActivity}" Style="{StaticResource OB.Section}" FontSize="13" Margin="0,0,0,10" />
                        <TextBlock Text="{h:L Dash_NoActivity}" Style="{StaticResource OB.Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding RecentActivity.Count, Converter={StaticResource ZeroToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding RecentActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="15" Foreground="{DynamicResource OB.Subtext}"
                                                       VerticalAlignment="Top" Margin="0,1,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource OB.Body}" FontSize="12.5" />
                                            <TextBlock Style="{StaticResource OB.FaintText}">
                                                <Run Text="{Binding Detail, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding TimeText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel>
                        <!-- CPU + RAM -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="84" Height="84">
                                    <c:RingGauge Value="{Binding Cpu}" Thickness="6" />
                                    <c:CountUpText Value="{Binding CpuPercent}" Mode="Percent" FontSize="18" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource OB.DisplayFont}" Foreground="{DynamicResource OB.Text}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{h:L Live_Cpu}" Style="{StaticResource OB.Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                    <ui:SymbolIcon Symbol="Temperature24" FontSize="11" Foreground="{DynamicResource OB.Faint}" Margin="0,0,3,0" />
                                    <TextBlock Text="{Binding TempText}" Style="{StaticResource OB.FaintText}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <Grid Width="84" Height="84">
                                    <c:RingGauge Value="{Binding Ram}" Thickness="6" />
                                    <c:CountUpText Value="{Binding RamPercent}" Mode="Percent" FontSize="18" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource OB.DisplayFont}" Foreground="{DynamicResource OB.Text}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{h:L Live_Ram}" Style="{StaticResource OB.Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding RamText}" Style="{StaticResource OB.FaintText}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource OB.Stroke}" Margin="0,18,0,16" />

                        <!-- disk -->
                        <Grid>
                            <TextBlock Style="{StaticResource OB.Body}" FontSize="12.5">
                                <Run Text="{h:L Live_Disk}" /><Run Text=" " /><Run Text="{Binding DiskTitle, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                        <c:GradientBar Value="{Binding Disk}" Height="5" Margin="0,8,0,6" />
                        <TextBlock Text="{Binding DiskText}" Style="{StaticResource OB.FaintText}" />

                        <!-- network -->
                        <TextBlock Text="{h:L Live_Network}" Style="{StaticResource OB.Body}" FontSize="12.5" Margin="0,18,0,0" />
                        <c:Sparkline Values="{Binding NetHistory}" Height="30" Margin="0,8,0,6" />
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDown24" FontSize="11" Foreground="{DynamicResource OB.Faint}" Margin="0,0,3,0" />
                                <TextBlock Text="{Binding NetDownText}" Style="{StaticResource OB.FaintText}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:SymbolIcon Symbol="ArrowUp24" FontSize="11" Foreground="{DynamicResource OB.Faint}" Margin="0,0,3,0" />
                                <TextBlock Text="{Binding NetUpText}" Style="{StaticResource OB.FaintText}" />
                            </StackPanel>
                        </Grid>

                        <!-- battery (laptops) -->
                        <StackPanel Margin="0,18,0,0" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding BatteryText}" Style="{StaticResource OB.Body}" FontSize="12.5" />
                            <c:GradientBar Value="{Binding Battery}" Height="5" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- dialog layer -->
            <Grid x:Name="DialogLayer" Grid.ColumnSpan="3" Visibility="Collapsed" Panel.ZIndex="10">
                <Border x:Name="DialogBackdrop" Background="{DynamicResource OB.Backdrop}" />
                <ContentControl x:Name="DialogHost" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" />
            </Grid>

            <!-- toast -->
            <Border x:Name="ToastHost" Grid.Column="1" Panel.ZIndex="20" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" MaxWidth="560"
                    CornerRadius="12" Padding="12,10,18,10" Background="{DynamicResource OB.DialogBg}"
                    BorderBrush="{DynamicResource OB.StrokeStrong}" BorderThickness="1" Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#000000" RenderingBias="Performance" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="ToastBadge" Width="24" Height="24" CornerRadius="12" Margin="0,0,11,0" Background="{StaticResource OB.Accent}">
                        <ui:SymbolIcon x:Name="ToastIcon" Symbol="Info24" FontSize="14" Foreground="White" />
                    </Border>
                    <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource OB.Text}" TextWrapping="Wrap" MaxWidth="480" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
