<UserControl
    x:Class="Vanish.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    xmlns:c="clr-namespace:Vanish.Controls">

    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource OB.CardBox}">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,8,40,32" MaxWidth="880" HorizontalAlignment="Stretch">
            <c:PageHeader Title="{h:L Nav_Settings}" Subtitle="{h:L Settings_Subtitle}" Symbol="Settings24" />

            <!-- appearance -->
            <TextBlock Text="{h:L Settings_Appearance}" Style="{StaticResource OB.Section}" Margin="0,0,0,10" />
            <Border Style="{StaticResource SettingRow}" c:Reveal.Enabled="True">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DarkTheme24" FontSize="18" Foreground="{DynamicResource OB.Subtext}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="{h:L Settings_Theme}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Settings_ThemeText}" Style="{StaticResource OB.Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource OB.SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource OB.Segment}" GroupName="theme" Content="{h:L Settings_ThemeDark}"
                                         IsChecked="{Binding Current.Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=dark}" />
                            <RadioButton Style="{StaticResource OB.Segment}" GroupName="theme" Content="{h:L Settings_ThemeLight}"
                                         IsChecked="{Binding Current.Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=light}" />
                            <RadioButton Style="{StaticResource OB.Segment}" GroupName="theme" Content="{h:L Settings_ThemeSystem}"
                                         IsChecked="{Binding Current.Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=system}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}" c:Reveal.Enabled="True" c:Reveal.Delay="30">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="18" Foreground="{DynamicResource OB.Subtext}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="{h:L Settings_Language}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Settings_LanguageText}" Style="{StaticResource OB.Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource OB.SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource OB.Segment}" GroupName="lang" Content="Türkçe" Command="{Binding SetLanguageCommand}" CommandParameter="tr"
                                         IsChecked="{Binding IsTurkish, Source={x:Static h:Loc.I}, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource OB.Segment}" GroupName="lang" Content="English" Command="{Binding SetLanguageCommand}" CommandParameter="en"
                                         IsChecked="{Binding IsEnglish, Source={x:Static h:Loc.I}, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}" c:Reveal.Enabled="True" c:Reveal.Delay="60">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Pulse24" FontSize="18" Foreground="{DynamicResource OB.Subtext}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="{h:L Settings_LivePanel}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Settings_LivePanelText}" Style="{StaticResource OB.Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Current.ShowLivePanel}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}" c:Reveal.Enabled="True" c:Reveal.Delay="90">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" Foreground="{DynamicResource OB.Subtext}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="{h:L Settings_ReduceMotion}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Settings_ReduceMotionText}" Style="{StaticResource OB.Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Current.ReduceAnimations}" />
                </Grid>
            </Border>

            <!-- uninstall -->
            <TextBlock Text="{h:L Settings_Uninstall}" Style="{StaticResource OB.Section}" Margin="0,22,0,10" />
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Foreground="{DynamicResource OB.Subtext}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="{h:L Settings_RestorePoint}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Settings_RestorePointText}" Style="{StaticResource OB.Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Current.CreateRestorePoint}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="18" Foreground="{DynamicResource OB.Subtext}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="{h:L Settings_RecycleBin}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Settings_RecycleBinText}" Style="{StaticResource OB.Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Current.UseRecycleBin}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="18" Foreground="{DynamicResource OB.Subtext}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="{h:L Settings_Confirm}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Settings_ConfirmText}" Style="{StaticResource OB.Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Current.ConfirmBeforeUninstall}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Flash24" FontSize="18" Foreground="{DynamicResource OB.Subtext}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="{h:L Settings_Silent}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Settings_SilentText}" Style="{StaticResource OB.Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Current.SilentUninstall}" />
                </Grid>
            </Border>

            <!-- data + about -->
            <TextBlock Text="{h:L Settings_Data}" Style="{StaticResource OB.Section}" Margin="0,22,0,10" />
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="18" Foreground="{DynamicResource OB.Subtext}" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Text="{h:L Settings_DataFolder}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Settings_DataFolderText}" Style="{StaticResource OB.Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource OB.Btn}" Content="{h:L Act_Open}" Command="{Binding OpenDataFolderCommand}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Oblivion;component/Assets/OblivionLogo.png" Width="22" Height="22" Margin="0,0,12,0" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource OB.BodyStrong}"><Run Text="Oblivion " /><Run Text="{Binding VersionText, Mode=OneWay}" /></TextBlock>
                            <TextBlock Text="{h:L Settings_AboutText}" Style="{StaticResource OB.Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OB.Btn}" Margin="0,0,8,0" Content="GitHub" Command="{Binding OpenGitHubCommand}" />
                        <Button Style="{StaticResource OB.BtnPrimary}" Command="{Binding ShowAboutCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info24" FontSize="15" Foreground="White" Margin="0,0,7,0" />
                                <TextBlock Text="{h:L Rail_About}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
