<UserControl
    x:Class="Vanish.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    xmlns:models="clr-namespace:Vanish.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock FontSize="26" FontWeight="Bold" Text="{Binding [Nav_Dashboard], Source={x:Static h:Loc.I}}" />
                <TextBlock Opacity="0.6" Text="{Binding [Made_By], Source={x:Static h:Loc.I}}" />
            </StackPanel>

            <!-- Stat cards -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                <ui:Card Margin="0,0,6,0" Padding="18">
                    <StackPanel>
                        <ui:FontIcon Glyph="&#xE71D;" FontFamily="Segoe Fluent Icons" FontSize="20" Opacity="0.7" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding InstalledCount}" FontSize="28" FontWeight="Bold" />
                        <TextBlock Opacity="0.6" FontSize="12" Text="{Binding [Stat_Installed], Source={x:Static h:Loc.I}}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6,0" Padding="18">
                    <StackPanel>
                        <ui:FontIcon Glyph="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="20" Opacity="0.7" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding TotalSize}" FontSize="28" FontWeight="Bold" />
                        <TextBlock Opacity="0.6" FontSize="12" Text="{Binding [Stat_Footprint], Source={x:Static h:Loc.I}}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6,0" Padding="18">
                    <StackPanel>
                        <ui:FontIcon Glyph="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="20" Opacity="0.7" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding StartupCount}" FontSize="28" FontWeight="Bold" />
                        <TextBlock Opacity="0.6" FontSize="12" Text="{Binding [Dash_Startup], Source={x:Static h:Loc.I}}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="6,0,0,0" Padding="18">
                    <StackPanel>
                        <ui:FontIcon Glyph="&#xEDA2;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#4CAF50" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding FreeSpace}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Opacity="0.6" FontSize="12" Text="{Binding [Dash_FreeSpace], Source={x:Static h:Loc.I}}" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!-- Quick actions -->
            <ui:Card Grid.Row="2" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,10" Text="{Binding [Dash_QuickActions], Source={x:Static h:Loc.I}}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Appearance="Secondary"
                                   Content="{Binding [Nav_AllApps], Source={x:Static h:Loc.I}}"
                                   Command="{Binding GoCommand}" CommandParameter="Uninstaller" />
                        <ui:Button Margin="0,0,8,0" Appearance="Secondary"
                                   Content="{Binding [Nav_WindowsApps], Source={x:Static h:Loc.I}}"
                                   Command="{Binding GoCommand}" CommandParameter="WindowsApps" />
                        <ui:Button Margin="0,0,8,0" Appearance="Secondary"
                                   Content="{Binding [Tool_Junk], Source={x:Static h:Loc.I}}"
                                   Command="{Binding GoCommand}" CommandParameter="Junk" />
                        <ui:Button Appearance="Secondary"
                                   Content="{Binding [Tool_Startup], Source={x:Static h:Loc.I}}"
                                   Command="{Binding GoCommand}" CommandParameter="Startup" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Largest apps + recent activity -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Margin="0,0,6,0" Padding="16">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="{Binding [Dash_Largest], Source={x:Static h:Loc.I}}" />
                        <ItemsControl ItemsSource="{Binding LargestApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:InstalledProgram}">
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Width="20" Height="20" Margin="0,0,10,0"
                                               Source="{Binding DisplayIcon, Converter={StaticResource DisplayIconToImage}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" FontWeight="SemiBold" Opacity="0.8" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="1" Margin="6,0,0,0" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center"
                                       Text="{Binding [Dash_RecentActivity], Source={x:Static h:Loc.I}}" />
                            <ui:Button HorizontalAlignment="Right" Appearance="Secondary" Padding="10,3"
                                       Content="{Binding [Act_Refresh], Source={x:Static h:Loc.I}}" Command="{Binding LoadCommand}" />
                        </Grid>
                        <TextBlock Opacity="0.5" FontSize="12" TextWrapping="Wrap"
                                   Text="{Binding [Dash_NoActivity], Source={x:Static h:Loc.I}}"
                                   Visibility="{Binding RecentActivity.Count, Converter={StaticResource ZeroCountToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding RecentActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:LogEntry}">
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" Opacity="0.55" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
