<UserControl
    x:Class="Vanish.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    xmlns:c="clr-namespace:Vanish.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel Margin="40,8,40,32">
            <c:PageHeader Title="{Binding Greeting}" Subtitle="{h:L Dash_Subtitle}" Symbol="Home24">
                <Button Style="{StaticResource OB.Btn}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="15" Margin="0,0,7,0" />
                        <TextBlock Text="{h:L Act_Refresh}" />
                    </StackPanel>
                </Button>
            </c:PageHeader>

            <!-- health -->
            <Border Style="{StaticResource OB.CardBox}" CornerRadius="12" Padding="24" c:Reveal.Enabled="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="132" Height="132" VerticalAlignment="Top">
                        <c:RingGauge Value="{Binding HealthFraction}" Thickness="11" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <c:CountUpText Value="{Binding HealthScore}" FontSize="34" FontWeight="SemiBold" FontFamily="{StaticResource OB.DisplayFont}"
                                           Foreground="{DynamicResource OB.Text}" HorizontalAlignment="Center" />
                            <TextBlock Text="/ 100" Style="{StaticResource OB.FaintText}" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="24,2,0,0">
                        <TextBlock Text="{h:L Dash_Health}" Style="{StaticResource OB.Caption}" />
                        <TextBlock Text="{Binding HealthTitle}" Style="{StaticResource OB.Title}" FontSize="22" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding HealthText}" Style="{StaticResource OB.Subtitle}" />
                        <ItemsControl ItemsSource="{Binding Tips}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource OB.Row}" Padding="12,8" c:Reveal.Enabled="True" c:Reveal.Stagger="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="17" Foreground="{DynamicResource OB.AccentText}" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource OB.Body}" TextWrapping="Wrap"
                                                       TextTrimming="None" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Style="{StaticResource OB.Btn}" Padding="11,5" FontSize="12" Margin="10,0,0,0"
                                                    Content="{Binding ActionText}" CommandParameter="{Binding Target}"
                                                    Command="{Binding DataContext.GoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- stats -->
            <UniformGrid Columns="4" Margin="-6,14,-6,0" c:Reveal.Enabled="True" c:Reveal.Delay="70">
                <Button Style="{StaticResource OB.Tile}" Margin="6" Padding="16" Command="{Binding GoCommand}" CommandParameter="Uninstaller">
                    <StackPanel>
                        <c:GradientBadge Symbol="AppsList24" Size="40" />
                        <c:CountUpText Value="{Binding ProgramCount}" Style="{StaticResource OB.BigNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="{h:L Dash_Programs}" Style="{StaticResource OB.BodyStrong}" FontSize="12.5" />
                        <TextBlock Text="{Binding ProgramSizeText}" Style="{StaticResource OB.FaintText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OB.Tile}" Margin="6" Padding="16" Command="{Binding GoCommand}" CommandParameter="WindowsApps">
                    <StackPanel>
                        <c:GradientBadge Symbol="StoreMicrosoft24" Size="40" From="#22C55E" To="#14B8A6" />
                        <c:CountUpText Value="{Binding StoreAppCount}" Style="{StaticResource OB.BigNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="{h:L Dash_StoreApps}" Style="{StaticResource OB.BodyStrong}" FontSize="12.5" />
                        <TextBlock Text="{h:L Dash_StoreAppsDetail}" Style="{StaticResource OB.FaintText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OB.Tile}" Margin="6" Padding="16" Command="{Binding GoCommand}" CommandParameter="Startup">
                    <StackPanel>
                        <c:GradientBadge Symbol="Power24" Size="40" From="#F5A524" To="#FF7A45" />
                        <c:CountUpText Value="{Binding StartupCount}" Style="{StaticResource OB.BigNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="{h:L Dash_Startup}" Style="{StaticResource OB.BodyStrong}" FontSize="12.5" />
                        <TextBlock Text="{Binding StartupDetail}" Style="{StaticResource OB.FaintText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OB.Tile}" Margin="6" Padding="16" Command="{Binding GoCommand}" CommandParameter="BrowserExt">
                    <StackPanel>
                        <c:GradientBadge Symbol="PuzzlePiece24" Size="40" From="#3A8DFF" To="#6F5BFF" />
                        <c:CountUpText Value="{Binding ExtensionCount}" Style="{StaticResource OB.BigNumber}" Margin="0,12,0,0" />
                        <TextBlock Text="{h:L Dash_Extensions}" Style="{StaticResource OB.BodyStrong}" FontSize="12.5" />
                        <TextBlock Text="{Binding ExtensionDetail}" Style="{StaticResource OB.FaintText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- quick actions -->
            <TextBlock Text="{h:L Dash_QuickActions}" Style="{StaticResource OB.Section}" Margin="0,18,0,4" />
            <UniformGrid Columns="3" Margin="-6,0,-6,0">
                <Button Style="{StaticResource OB.Tile}" Margin="6" Padding="16,14" Command="{Binding GoCommand}" CommandParameter="Uninstaller"
                        c:Reveal.Enabled="True" c:Reveal.Delay="120">
                    <StackPanel Orientation="Horizontal">
                        <c:GradientBadge Symbol="Delete24" Size="38" From="#FF6B6B" To="#E5484D" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{h:L Quick_Uninstall}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Quick_Uninstall_D}" Style="{StaticResource OB.FaintText}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OB.Tile}" Margin="6" Padding="16,14" Command="{Binding GoCommand}" CommandParameter="Junk"
                        c:Reveal.Enabled="True" c:Reveal.Delay="150">
                    <StackPanel Orientation="Horizontal">
                        <c:GradientBadge Symbol="Broom24" Size="38" From="#3A8DFF" To="#6F5BFF" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{h:L Quick_Junk}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Quick_Junk_D}" Style="{StaticResource OB.FaintText}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OB.Tile}" Margin="6" Padding="16,14" Command="{Binding GoCommand}" CommandParameter="SystemMonitor"
                        c:Reveal.Enabled="True" c:Reveal.Delay="180">
                    <StackPanel Orientation="Horizontal">
                        <c:GradientBadge Symbol="Pulse24" Size="38" From="#18C29C" To="#2E8BFF" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{h:L Quick_Monitor}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Quick_Monitor_D}" Style="{StaticResource OB.FaintText}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OB.Tile}" Margin="6" Padding="16,14" Command="{Binding GoCommand}" CommandParameter="Startup"
                        c:Reveal.Enabled="True" c:Reveal.Delay="210">
                    <StackPanel Orientation="Horizontal">
                        <c:GradientBadge Symbol="Power24" Size="38" From="#6E5BFF" To="#B45BFF" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{h:L Quick_Startup}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Quick_Startup_D}" Style="{StaticResource OB.FaintText}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OB.Tile}" Margin="6" Padding="16,14" Command="{Binding GoCommand}" CommandParameter="LargeFiles"
                        c:Reveal.Enabled="True" c:Reveal.Delay="240">
                    <StackPanel Orientation="Horizontal">
                        <c:GradientBadge Symbol="DocumentSearch24" Size="38" From="#F5A524" To="#FF7A45" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{h:L Quick_LargeFiles}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Quick_LargeFiles_D}" Style="{StaticResource OB.FaintText}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OB.Tile}" Margin="6" Padding="16,14" Command="{Binding GoCommand}" CommandParameter="History"
                        c:Reveal.Enabled="True" c:Reveal.Delay="270">
                    <StackPanel Orientation="Horizontal">
                        <c:GradientBadge Symbol="EyeOff24" Size="38" From="#14B8A6" To="#22C55E" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{h:L Quick_Privacy}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{h:L Quick_Privacy_D}" Style="{StaticResource OB.FaintText}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- recent activity -->
            <Border Style="{StaticResource OB.CardBox}" CornerRadius="12" Margin="0,14,0,0" c:Reveal.Enabled="True" c:Reveal.Delay="160">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{h:L Dash_RecentActivity}" Style="{StaticResource OB.Section}" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource OB.BtnGhost}" Padding="8,3" FontSize="12"
                                Command="{Binding GoCommand}" CommandParameter="Logs">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{h:L Dash_AllLogs}" Foreground="{DynamicResource OB.AccentText}" />
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="12" Margin="3,1,0,0" Foreground="{DynamicResource OB.AccentText}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{h:L Dash_NoActivity}" Style="{StaticResource OB.Caption}"
                               Visibility="{Binding Activity.Count, Converter={StaticResource ZeroToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource OB.CardStrong}" Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="15" Foreground="{DynamicResource OB.Subtext}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource OB.BodyStrong}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource OB.Caption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource OB.FaintText}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
