<UserControl
    x:Class="Vanish.Views.Pages.EvidencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    xmlns:c="clr-namespace:Vanish.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22,26,24">
            <c:PageHeader Title="{h:L Tool_Evidence}" Subtitle="{h:L Evid_Subtitle}" Symbol="EraserTool24" From="#EC4899" To="#8B5CF6" />

            <Border Style="{StaticResource OB.CardBox}" CornerRadius="18" Padding="16" c:Reveal.Enabled="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Info24" FontSize="18" Foreground="{StaticResource OB.Info}" Margin="0,0,12,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{h:L Evid_Explain}" Style="{StaticResource OB.Body}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None" />
                </Grid>
            </Border>

            <TextBlock Text="{h:L Evid_ChooseDrive}" Style="{StaticResource OB.Section}" Margin="0,18,0,8" />
            <ItemsControl ItemsSource="{Binding Drives}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="evidDrive" Margin="0,0,10,10" Checked="Drive_Checked" Loaded="Drive_Loaded" Tag="{Binding}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="bd" CornerRadius="16" Padding="14" BorderThickness="1.5" Background="{DynamicResource OB.Card}"
                                            BorderBrush="{DynamicResource OB.Stroke}" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <c:GradientBadge Symbol="HardDrive20" Size="40" From="#EC4899" To="#8B5CF6" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource OB.BodyStrong}" />
                                                    <c:Chip Text="SSD" Tint="#3A8DFF" Margin="8,0,0,0" Visibility="{Binding IsSsd, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource OB.Caption}"><Run Text="{h:L Evid_Free}" /><Run Text=": " /><Run Text="{Binding Detail, Mode=OneWay}" /></TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource OB.CardHover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OB.Brand}" />
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource OB.AccentSoft}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Margin="0,4,0,0" CornerRadius="12" Padding="12,9" Background="{DynamicResource OB.WarningSoft}"
                    Visibility="{Binding SsdWarning, Converter={StaticResource BoolToVisibility}}" c:SlideIn.Enabled="True">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="{StaticResource OB.Warning}" Margin="0,0,10,0" />
                    <TextBlock Text="{h:L Evid_SsdNote}" Style="{StaticResource OB.Body}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None" MaxWidth="660" />
                </StackPanel>
            </Border>

            <!-- running -->
            <Border Style="{StaticResource OB.CardBox}" CornerRadius="18" Padding="18" Margin="0,14,0,0"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" c:SlideIn.Enabled="True">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <c:Spinner Width="26" Height="26" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource OB.BodyStrong}" />
                                <TextBlock Style="{StaticResource OB.Caption}"><Run Text="{h:L Evid_Elapsed}" /><Run Text=": " /><Run Text="{Binding ElapsedText, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource OB.Btn}" Content="{h:L Act_Stop}" Command="{Binding StopCommand}" />
                    </Grid>
                    <UniformGrid Columns="3" Margin="0,16,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <c:StepDot Step="1" Current="{Binding Pass}" HorizontalAlignment="Left" />
                            <TextBlock Text="{h:L Evid_Pass1}" Style="{StaticResource OB.Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <c:StepDot Step="2" Current="{Binding Pass}" HorizontalAlignment="Left" />
                            <TextBlock Text="{h:L Evid_Pass2}" Style="{StaticResource OB.Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <c:StepDot Step="3" Current="{Binding Pass}" HorizontalAlignment="Left" />
                            <TextBlock Text="{h:L Evid_Pass3}" Style="{StaticResource OB.Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </UniformGrid>
                    <c:GradientBar Value="-1" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource OB.Caption}" VerticalAlignment="Center" Margin="0,0,14,0"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                <Button Style="{StaticResource OB.BtnPrimaryLarge}" Command="{Binding StartCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="EraserTool24" FontSize="17" Foreground="White" Margin="0,0,8,0" />
                        <TextBlock Text="{h:L Evid_Start}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
