<UserControl
    x:Class="Vanish.Views.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    xmlns:c="clr-namespace:Vanish.Controls">

    <Grid Margin="26,22,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="{h:L Nav_Logs}" Subtitle="{h:L Logs_Subtitle}" Symbol="History24" From="#6E5BFF" To="#3A8DFF">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource OB.Btn}" Margin="0,0,8,0" Command="{Binding OpenFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="15" Margin="0,0,7,0" />
                        <TextBlock Text="{h:L Logs_OpenFolder}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OB.Btn}" Command="{Binding ClearCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="15" Margin="0,0,7,0" Foreground="{StaticResource OB.Danger}" />
                        <TextBlock Text="{h:L Act_Clear}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </c:PageHeader>

        <ui:TextBox Grid.Row="1" Margin="0,0,0,10" MaxWidth="340" HorizontalAlignment="Left" Width="340" PlaceholderText="{h:L Logs_Search}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True">
            <ui:TextBox.Icon>
                <ui:SymbolIcon Symbol="Search24" />
            </ui:TextBox.Icon>
        </ui:TextBox>

        <ListBox Grid.Row="2" Style="{StaticResource OB.List}" ItemsSource="{Binding Entries}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid c:Reveal.Enabled="True" c:Reveal.Stagger="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource OB.AccentSoft}" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Foreground="{StaticResource OB.Accent}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource OB.Caption}" ToolTip="{Binding Detail}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Style="{StaticResource OB.FaintText}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <c:EmptyState Grid.Row="2" Symbol="History24" Title="{h:L Logs_EmptyTitle}" Text="{h:L Logs_EmptyText}"
                      Visibility="{Binding Count, Converter={StaticResource ZeroToVisibility}}" />
    </Grid>
</UserControl>
