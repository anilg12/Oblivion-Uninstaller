<UserControl
    x:Class="Vanish.Views.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    xmlns:c="clr-namespace:Vanish.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel Margin="40,8,40,32">
            <c:PageHeader Title="{h:L Nav_Tools}" Subtitle="{h:L Tools_Subtitle}" Symbol="Toolbox24" />

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource OB.Section}" Margin="0,4,0,6" />
                            <ItemsControl ItemsSource="{Binding Tiles}" Margin="-6,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource OB.Tile}" Margin="6" Padding="16,15" CommandParameter="{Binding Tag}"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                c:Reveal.Enabled="True" c:Reveal.Stagger="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <c:GradientBadge Symbol="{Binding Symbol}" From="{Binding From}" To="{Binding To}" Size="46" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource OB.BodyStrong}" FontSize="14" />
                                                        <Border CornerRadius="6" Padding="6,1" Margin="8,0,0,0" Background="{DynamicResource OB.SuccessSoft}" VerticalAlignment="Center"
                                                                Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{h:L Badge_New}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource OB.Success}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource OB.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="14" Foreground="{DynamicResource OB.Faint}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
