<UserControl
    x:Class="Vanish.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    xmlns:c="clr-namespace:Vanish.Controls">

    <Grid Margin="40,8,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="{h:L Tool_History}" Subtitle="{h:L Priv_Subtitle}" Symbol="EyeOff24" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource OB.CardBox}" Margin="0,0,10,10" CornerRadius="12" Padding="14" c:Reveal.Enabled="True" c:Reveal.Stagger="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <c:GradientBadge Grid.Column="1" Symbol="{Binding Symbol}" Size="40" From="#14B8A6" To="#22C55E" Margin="0,0,12,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource OB.BodyStrong}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource OB.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource OB.Caption}" Foreground="{DynamicResource OB.AccentText}" FontWeight="SemiBold"
                                               Margin="0,4,0,0" Visibility="{Binding CountText, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,4,0,0" Style="{StaticResource OB.CardBox}" Padding="14,10" CornerRadius="12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" Foreground="{StaticResource OB.Success}" Margin="0,0,8,0" />
                    <TextBlock Text="{h:L Priv_Footer}" Style="{StaticResource OB.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OB.Btn}" Margin="0,0,8,0" Content="{h:L Act_SelectNone}" Command="{Binding SelectNoneCommand}" />
                    <Button Style="{StaticResource OB.BtnDanger}" Command="{Binding CleanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Broom24" FontSize="15" Foreground="White" Margin="0,0,7,0" />
                            <TextBlock Text="{h:L Priv_CleanSelected}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
