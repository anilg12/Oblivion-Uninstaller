<UserControl
    x:Class="Vanish.Views.Pages.LargeFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    xmlns:c="clr-namespace:Vanish.Controls">

    <Grid Margin="40,8,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="{h:L Tool_LargeFiles}" Subtitle="{h:L Large_Subtitle}" Symbol="DocumentSearch24" />

        <!-- options -->
        <Border Grid.Row="1" Style="{StaticResource OB.CardBox}" CornerRadius="12" Padding="16,14" Margin="0,0,0,12" c:Reveal.Enabled="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{h:L Large_Where}" Style="{StaticResource OB.Caption}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}" MinWidth="260" MaxWidth="360"
                                  IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.65" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Style="{StaticResource OB.Btn}" Margin="8,0,0,0" Command="{Binding PickFolderCommand}" ToolTip="{h:L Large_PickFolder}"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0">
                    <TextBlock Text="{h:L Large_MinSize}" Style="{StaticResource OB.Caption}" Margin="0,0,0,6" />
                    <Border Style="{StaticResource OB.SegmentHost}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource OB.Segment}" GroupName="minSize" Content="100 MB"
                                         IsChecked="{Binding MinSize, Converter={StaticResource EqualsConverter}, ConverterParameter=100}" />
                            <RadioButton Style="{StaticResource OB.Segment}" GroupName="minSize" Content="500 MB"
                                         IsChecked="{Binding MinSize, Converter={StaticResource EqualsConverter}, ConverterParameter=500}" />
                            <RadioButton Style="{StaticResource OB.Segment}" GroupName="minSize" Content="1 GB"
                                         IsChecked="{Binding MinSize, Converter={StaticResource EqualsConverter}, ConverterParameter=1024}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource OB.BtnPrimary}" Command="{Binding ScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" FontSize="15" Foreground="White" Margin="0,0,7,0" />
                            <TextBlock Text="{h:L Large_Scan}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OB.Btn}" Command="{Binding StopCommand}" Content="{h:L Act_Stop}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <ListBox Grid.Row="2" Style="{StaticResource OB.List}" ItemsSource="{Binding Files}" SelectionMode="Multiple">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource OB.ListItem}">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid c:Reveal.Enabled="True" c:Reveal.Stagger="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Grid Grid.Column="1" Width="32" Height="32" Margin="0,0,12,0">
                            <Border CornerRadius="9" Background="{DynamicResource OB.CardStrong}">
                                <ui:SymbolIcon Symbol="Document24" FontSize="15" Foreground="{DynamicResource OB.Faint}" />
                            </Border>
                            <Image c:IconLoader.Path="{Binding Path}" Width="24" Height="24" />
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource OB.BodyStrong}" />
                            <TextBlock Text="{Binding Folder}" Style="{StaticResource OB.FaintText}" ToolTip="{Binding Folder}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding DateText}" Style="{StaticResource OB.FaintText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="4" Text="{Binding SizeText}" Style="{StaticResource OB.BodyStrong}" FontSize="12.5" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                        <Button Grid.Column="5" Style="{StaticResource OB.BtnGhost}" Padding="6" Margin="6,0,0,0" ToolTip="{h:L Act_ShowLocation}"
                                CommandParameter="{Binding}" Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <ui:SymbolIcon Symbol="Open24" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
            <c:Spinner Width="38" Height="38" Thickness="3.5" />
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource OB.Caption}" Margin="0,10,0,0" HorizontalAlignment="Center" />
        </StackPanel>
        <c:EmptyState Grid.Row="2" Symbol="DocumentSearch24" Title="{h:L Large_EmptyTitle}" Text="{h:L Large_EmptyText}"
                      Visibility="{Binding HasScanned, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

        <Border Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource OB.CardBox}" Padding="14,10" CornerRadius="12">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource OB.Caption}" />
                    <TextBlock Text="{Binding SelectedText}" Style="{StaticResource OB.BodyStrong}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OB.Btn}" Margin="0,0,8,0" Content="{h:L Act_SelectNone}" Command="{Binding SelectNoneCommand}" />
                    <Button Style="{StaticResource OB.BtnDanger}" Command="{Binding RecycleCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="White" Margin="0,0,7,0" />
                            <TextBlock Text="{h:L Act_MoveToRecycle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
