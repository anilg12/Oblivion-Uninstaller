<UserControl
    x:Class="Vanish.Views.Pages.ShredderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:h="clr-namespace:Vanish.Helpers"
    xmlns:c="clr-namespace:Vanish.Controls">

    <Grid Margin="26,22,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:PageHeader Title="{h:L Tool_Shredder}" Subtitle="{h:L Shred_Subtitle}" Symbol="Fire24" From="#FF6B6B" To="#E5484D">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource OB.Btn}" Margin="0,0,8,0" Command="{Binding AddFilesCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="15" Margin="0,0,7,0" />
                        <TextBlock Text="{h:L Shred_AddFiles}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OB.Btn}" Command="{Binding AddFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderAdd24" FontSize="15" Margin="0,0,7,0" />
                        <TextBlock Text="{h:L Shred_AddFolder}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </c:PageHeader>

        <Border Grid.Row="1" Margin="0,0,0,12" CornerRadius="12" Padding="12,9" Background="{StaticResource OB.DangerSoft}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="{StaticResource OB.Danger}" Margin="0,0,10,0" />
                <TextBlock Text="{h:L Shred_Warning}" Style="{StaticResource OB.Body}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None" MaxWidth="680" />
            </StackPanel>
        </Border>

        <!-- drop zone + list -->
        <Border Grid.Row="2" CornerRadius="18" BorderThickness="1.5" BorderBrush="{DynamicResource OB.Stroke}" Background="{DynamicResource OB.Card}">
            <Grid>
                <c:EmptyState Symbol="ArrowDownload24" Title="{h:L Shred_DropTitle}" Text="{h:L Shred_DropText}"
                              Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisibility}}" />
                <ListBox Style="{StaticResource OB.List}" ItemsSource="{Binding Items}" Margin="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid c:Reveal.Enabled="True" c:Reveal.Stagger="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource OB.DangerSoft}" Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="15" Foreground="{StaticResource OB.Danger}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource OB.BodyStrong}" />
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource OB.FaintText}" ToolTip="{Binding Path}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource OB.Caption}" VerticalAlignment="Center" Margin="10,0" />
                                <Button Grid.Column="3" Style="{StaticResource OB.BtnGhost}" Padding="6" ToolTip="{h:L Shred_RemoveFromList}" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource OB.CardBox}" Padding="14,10" CornerRadius="16">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{h:L Shred_Method}" Style="{StaticResource OB.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Border Style="{StaticResource OB.SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource OB.Segment}" GroupName="passes" Content="{h:L Shred_Pass1}"
                                             IsChecked="{Binding Passes, Converter={StaticResource EqualsConverter}, ConverterParameter=1}" />
                                <RadioButton Style="{StaticResource OB.Segment}" GroupName="passes" Content="{h:L Shred_Pass3}"
                                             IsChecked="{Binding Passes, Converter={StaticResource EqualsConverter}, ConverterParameter=3}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource OB.Caption}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OB.Btn}" Margin="0,0,8,0" Content="{h:L Act_ClearList}" Command="{Binding ClearCommand}" />
                        <Button Style="{StaticResource OB.BtnDanger}" Command="{Binding ShredCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Fire24" FontSize="15" Foreground="White" Margin="0,0,7,0" />
                                <TextBlock Text="{h:L Act_Shred}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0" Visibility="{Binding IsShredding, Converter={StaticResource BoolToVisibility}}" c:SlideIn.Enabled="True">
                    <c:GradientBar Value="{Binding Progress}" Margin="0,0,90,0" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource OB.Btn}" Padding="10,4" Content="{h:L Act_Stop}" Command="{Binding StopCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
