<Application
    x:Class="Vanish.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:Vanish.Helpers.Converters"
    ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- Swapped at runtime by ThemeService (Palette.Dark / Palette.Light). -->
                <ResourceDictionary Source="pack://application:,,,/Oblivion;component/Themes/Palette.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Oblivion;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:ZeroCountToVisibilityConverter x:Key="ZeroToVisibility" />
            <conv:PositiveToVisibilityConverter x:Key="PositiveToVisibility" />
            <conv:LangCodeUpperConverter x:Key="LangCodeUpper" />
            <conv:ColorToBrushConverter x:Key="ColorToBrush" />
            <conv:EqualsConverter x:Key="EqualsConverter" />
            <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
